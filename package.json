{
  "name": "foxmind-database-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test": "node scripts/test-database.mjs",
    "test:red": "node scripts/test-database.mjs --empty",
    "test:contract": "node --test --test-concurrency=1 tests/database.test.mjs",
    "api:build": "npm run db:generate && tsc -p apps/api/tsconfig.json",
    "api:start": "node .build/api/apps/api/src/main.js",
    "test:api": "node scripts/test-backend.mjs",
    "test:dependencies": "node --test tests/dependency-security.test.mjs",
    "audit:security": "npm audit",
    "mail:up": "node scripts/mail-compose.mjs up",
    "mail:stop": "node scripts/mail-compose.mjs stop",
    "mail:status": "node scripts/mail-compose.mjs status",
    "test:mail-capture": "node --test --test-concurrency=1 tests/p32-mail-command.test.mjs tests/p32-mail-capture.test.mjs",
    "test:mail": "npm run api:build && node --test --test-concurrency=1 tests/p32-mail-command.test.mjs tests/p32-mail-capture.test.mjs tests/p32-mailer.test.mjs tests/p32-mail-flow.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "validator": "13.15.35"
  },
  "overrides": {
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma@7.10.0": {
      "mysql2": "3.24.6"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/validator": "13.15.10",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  }
}
