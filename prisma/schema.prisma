// Database invariants not expressible here live in the custom migration.
generator client {
  provider = "prisma-client"
  output   = "../.generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EntryMethod {
  CODE
  INVITATION
}

enum EndReason {
  LEFT
  REMOVED
}

enum TopicStatus {
  PENDING
  NEXT
  TAUGHT
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScanStatus {
  PENDING
  RUNNING
  CLEAN
  REJECTED
  ERROR
}

enum UploadStatus {
  STARTED
  UPLOADING
  COMPLETED
  FAILED
  CANCELLED
}

enum ActivityType {
  ASSIGNMENT
  QUESTIONNAIRE
  EVALUATION
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum QuestionType {
  DEVELOPMENT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum ScoringRule {
  EXACT
  PARTIAL
}

enum EligibilityReason {
  INITIAL_ENROLLMENT
  REENTRY
  TEACHER_AUTHORIZATION
}

enum AttemptStatus {
  DRAFT
  SUBMITTED
}

enum PostType {
  NOTICE
  QUERY
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  foxy_visual_jobs FoxyVisualJob[]
  foxy_visual_assets FoxyVisualAsset[]
  foxy_private_asset_commands FoxyPrivateAssetCommand[]
  foxy_conversations FoxyConversation[]
  foxy_conversation_requests FoxyConversationRequest[]
  grading_ai_jobs GradingAiJob[]
  student_ai_reports StudentAiReport[]
  activity_generations ActivityAiGeneration[] @relation("ActivityGeneration_owner")
  activity_generation_requests ActivityAiRequest[] @relation("ActivityRequest_owner")
  curriculum_extractions ClassroomCurriculumExtraction[]
  classroom_ai_requests ClassroomAiRequest[]
  id                    String             @id @default(uuid()) @db.Uuid
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  email                 String
  email_normalized      String             @unique
  account_role          String
  first_name            String
  last_name             String
  password_hash         String
  email_verified_at     DateTime?          @db.Timestamptz(6)
  sessions              Session[]          @relation("Session_user_id")
  tokens                AccountToken[]     @relation("AccountToken_user_id")
  classroom_drafts      ClassroomDraft[]   @relation("ClassroomDraft_owner_id")
  taught_classrooms     Classroom[]        @relation("Classroom_teacher_id")
  enrollments           Enrollment[]       @relation("Enrollment_student_id")
  ended_memberships     MembershipPeriod[] @relation("MembershipPeriod_ended_by_id")
  sent_invitations      Invitation[]       @relation("Invitation_invited_by_id")
  accepted_invitations  Invitation[]       @relation("Invitation_accepted_by_id")
  uploaded_plans        StudyPlanVersion[] @relation("StudyPlanVersion_uploaded_by_id")
  materials             Material[]         @relation("Material_created_by_id")
  files                 FileObject[]       @relation("FileObject_uploaded_by_id")
  authorized_activities StudentActivity[]  @relation("StudentActivity_authorized_by_id")
  enabled_attempts      Attempt[]          @relation("Attempt_enabled_by_id")
  graded_attempts       AttemptGrade[]     @relation("AttemptGrade_graded_by_id")
  grade_corrections     GradeCorrection[]  @relation("GradeCorrection_actor_id")
  posts                 WallPost[]         @relation("WallPost_author_id")
  removed_posts         WallPost[]         @relation("WallPost_removed_by_id")
  replies               WallReply[]        @relation("WallReply_author_id")
  removed_replies       WallReply[]        @relation("WallReply_removed_by_id")
  notifications         Notification[]     @relation("Notification_recipient_id")
  agenda_events         AgendaEvent[]      @relation("AgendaEvent_owner")

  @@map("users")
}

model AgendaEvent {
  exceptions           Json      @default("[]")
  id                   String   @id @db.Uuid
  owner_id             String   @db.Uuid
  title                String
  description          String
  category             String
  color                String?
  schedule_kind        String
  start_date           DateTime @db.Date
  end_date_exclusive   DateTime @db.Date
  start_local          String?
  end_local            String?
  time_zone            String?
  start_offset_minutes Int?
  end_offset_minutes   Int?
  start_at             DateTime? @db.Timestamptz(6)
  end_at               DateTime? @db.Timestamptz(6)
  repeat_kind          String
  repeat_until         DateTime? @db.Date
  revision             BigInt   @default(0)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  owner                User     @relation("AgendaEvent_owner", fields: [owner_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([owner_id, start_date], map: "agenda_events_owner_start_idx")
  @@map("agenda_events")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user_id      String    @db.Uuid
  token_hash   String    @unique
  expires_at   DateTime  @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  last_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  user         User      @relation("Session_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([user_id, revoked_at])
  @@map("sessions")
}

model AccountToken {
  id             String       @id @default(uuid()) @db.Uuid
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  user_id        String       @db.Uuid
  purpose        TokenPurpose
  token_hash     String       @unique
  expires_at     DateTime     @db.Timestamptz(6)
  consumed_at    DateTime?    @db.Timestamptz(6)
  invalidated_at DateTime?    @db.Timestamptz(6)
  user           User         @relation("AccountToken_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([user_id, purpose])
  @@map("account_tokens")
}

model AccountActionControl {
  id                String   @id @default(uuid()) @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  action            String
  subject_key       String
  last_requested_at DateTime @db.Timestamptz(6)
  window_started_at DateTime @db.Timestamptz(6)
  request_count     Int      @default(0)

  @@unique([action, subject_key])
  @@map("account_action_controls")
}

model ClassroomDraft {
  curriculum_extractions ClassroomCurriculumExtraction[]
  id                     String       @id @default(uuid()) @db.Uuid
  created_at             DateTime     @default(now()) @db.Timestamptz(6)
  updated_at             DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  owner_id               String       @db.Uuid
  payload                Json         @default("{}")
  revision               BigInt       @default(0)
  published_classroom_id String?      @db.Uuid
  owner                  User         @relation("ClassroomDraft_owner_id", fields: [owner_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  published_classroom    Classroom?   @relation("Draft_publication", fields: [published_classroom_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  files                  FileObject[] @relation("File_draft")

  @@index([owner_id])
  @@map("classroom_drafts")
}

model Classroom {
  foxy_publications FoxyPublication[]
  foxy_conversations FoxyConversation[]
  grading_ai_jobs GradingAiJob[]
  ai_grading_enabled Boolean @default(false)
  ai_grading_epoch BigInt @default(0)
  student_ai_reports StudentAiReport[]
  activity_generations ActivityAiGeneration[] @relation("ActivityGeneration_classroom")
  id                  String             @id @default(uuid()) @db.Uuid
  revision            BigInt             @default(0)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  teacher_id          String             @db.Uuid
  name                String
  subject             String
  division            String
  academic_year       Int
  timezone            String
  cover_key           String
  storage_quota_bytes BigInt
  archived_at         DateTime?          @db.Timestamptz(6)
  teacher             User               @relation("Classroom_teacher_id", fields: [teacher_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  codes               ClassroomCode[]    @relation("ClassroomCode_classroom")
  enrollments         Enrollment[]       @relation("Enrollment_classroom")
  invitations         Invitation[]       @relation("Invitation_classroom")
  units               Unit[]             @relation("Unit_classroom")
  plan_versions       StudyPlanVersion[] @relation("StudyPlanVersion_classroom")
  materials           Material[]         @relation("Material_classroom")
  files               FileObject[]       @relation("FileObject_classroom")
  activities          Activity[]         @relation("Activity_classroom")
  posts               WallPost[]         @relation("WallPost_classroom")
  notifications       Notification[]     @relation("Notification_classroom")
  source_drafts       ClassroomDraft[]   @relation("Draft_publication")

  @@index([teacher_id])
  @@map("classrooms")
}

model ClassroomCode {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  classroom_id String    @db.Uuid
  code_digest  String    @unique
  code_envelope String?
  issued_at    DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  classroom    Classroom @relation("ClassroomCode_classroom", fields: [classroom_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([classroom_id])
  @@map("classroom_codes")
}

model Enrollment {
  student_ai_reports StudentAiReport[]
  id              String             @id @default(uuid()) @db.Uuid
  created_at      DateTime           @default(now()) @db.Timestamptz(6)
  updated_at      DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  classroom_id    String             @db.Uuid
  student_id      String             @db.Uuid
  first_joined_at DateTime           @default(now()) @db.Timestamptz(6)
  student         User               @relation("Enrollment_student_id", fields: [student_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  classroom       Classroom          @relation("Enrollment_classroom", fields: [classroom_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  periods         MembershipPeriod[] @relation("Membership_enrollment")
  activities      StudentActivity[]  @relation("StudentActivity_enrollment")

  @@unique([classroom_id, student_id])
  @@unique([id, classroom_id])
  @@index([student_id])
  @@map("enrollments")
}

model MembershipPeriod {
  id            String      @id @default(uuid()) @db.Uuid
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  enrollment_id String      @db.Uuid
  classroom_id  String      @db.Uuid
  joined_at     DateTime    @default(now()) @db.Timestamptz(6)
  ended_at      DateTime?   @db.Timestamptz(6)
  end_reason    EndReason?
  ended_by_id   String?     @db.Uuid
  entry_method  EntryMethod
  invitation_id String?     @db.Uuid
  ended_by      User?       @relation("MembershipPeriod_ended_by_id", fields: [ended_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  enrollment    Enrollment  @relation("Membership_enrollment", fields: [enrollment_id, classroom_id], references: [id, classroom_id], onDelete: Restrict, onUpdate: NoAction)
  invitation    Invitation? @relation("Membership_invitation", fields: [invitation_id, classroom_id], references: [id, classroom_id], onDelete: Restrict, onUpdate: NoAction)

  @@index([enrollment_id, joined_at])
  @@map("membership_periods")
}

model Invitation {
  id                         String             @id @default(uuid()) @db.Uuid
  created_at                 DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  classroom_id               String             @db.Uuid
  recipient_email_normalized String
  invited_by_id              String             @db.Uuid
  generation                 BigInt             @default(1)
  issued_at                  DateTime           @default(now()) @db.Timestamptz(6)
  expires_at                 DateTime           @db.Timestamptz(6)
  accepted_at                DateTime?          @db.Timestamptz(6)
  accepted_by_id             String?            @db.Uuid
  revoked_at                 DateTime?          @db.Timestamptz(6)
  invited_by                 User               @relation("Invitation_invited_by_id", fields: [invited_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  accepted_by                User?              @relation("Invitation_accepted_by_id", fields: [accepted_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  classroom                  Classroom          @relation("Invitation_classroom", fields: [classroom_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  membership_periods         MembershipPeriod[] @relation("Membership_invitation")

  @@unique([id, classroom_id])
  @@index([recipient_email_normalized, expires_at])
  @@map("invitations")
}

model Unit {
  id           String     @id @default(uuid()) @db.Uuid
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  classroom_id String     @db.Uuid
  name         String
  position     Int
  classroom    Classroom  @relation("Unit_classroom", fields: [classroom_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  topics       Topic[]    @relation("Topic_unit")
  materials    Material[] @relation("Material_unit")
  activities   Activity[] @relation("Activity_unit")

  @@unique([id, classroom_id])
  @@index([classroom_id, position])
  @@map("units")
}

model Topic {
  id           String      @id @default(uuid()) @db.Uuid
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  classroom_id String      @db.Uuid
  unit_id      String      @db.Uuid
  name         String
  position     Int
  status       TopicStatus @default(PENDING)
  unit         Unit        @relation("Topic_unit", fields: [unit_id, classroom_id], references: [id, classroom_id], onDelete: Restrict, onUpdate: NoAction)
  materials    Material[]  @relation("Material_topic")
  activities   Activity[]  @relation("Activity_topic")
  activity_links ActivityTopic[] @relation("ActivityTopic_topic")

  @@unique([id, unit_id, classroom_id])
  @@index([unit_id, position])
  @@map("topics")
}

model StudyPlanVersion {
  id             String     @id @default(uuid()) @db.Uuid
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  classroom_id   String     @db.Uuid
  version_number Int
  file_id        String     @db.Uuid
  uploaded_by_id String     @db.Uuid
  uploaded_by    User       @relation("StudyPlanVersion_uploaded_by_id", fields: [uploaded_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  classroom      Classroom  @relation("StudyPlanVersion_classroom", fields: [classroom_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  file           FileObject @relation("Plan_file", fields: [file_id, classroom_id], references: [id, classroom_id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([classroom_id, version_number])
  @@map("study_plan_versions")
}

model Material {
  previous_revisions MaterialRevision[] @relation("MaterialRevisionCurrent")
  next_revisions MaterialRevision[] @relation("MaterialRevisionPrevious")
  body           String?
  resource_use   String             @default("STUDY")
  content_kind   String             @default("FILE")
  id             String             @id @default(uuid()) @db.Uuid
  created_at     DateTime           @default(now()) @db.Timestamptz(6)
  updated_at     DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  classroom_id   String             @db.Uuid
  title          String
  file_id        String             @db.Uuid
  unit_id        String?            @db.Uuid
  topic_id       String?            @db.Uuid
  created_by_id  String             @db.Uuid
  deleted_at     DateTime?          @db.Timestamptz(6)
  deletion_claim_token String?      @db.Uuid
  deletion_lease_until DateTime?    @db.Timestamptz(6)
  deletion_error_code String?
  deletion_retry_at   DateTime?    @db.Timestamptz(6)
  deletion_retry_step Int          @default(0)
  created_by     User               @relation("Material_created_by_id", fields: [created_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  classroom      Classroom          @relation("Material_classroom", fields: [classroom_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  file           FileObject         @relation("Material_file", fields: [file_id, classroom_id], references: [id, classroom_id], onDelete: Restrict, onUpdate: NoAction)
  unit           Unit?              @relation("Material_unit", fields: [unit_id, classroom_id], references: [id, classroom_id], onDelete: Restrict, onUpdate: NoAction)
  topic          Topic?             @relation("Material_topic", fields: [topic_id, unit_id, classroom_id], references: [id, unit_id, classroom_id], onDelete: Restrict, onUpdate: NoAction)
  activity_links ActivityMaterial[] @relation("Link_material")
  foxy_publication FoxyPublication? @relation("FoxyPublicationMaterial")
  foxy_confirmation_requests FoxyPublicationConfirmRequest[] @relation("FoxyConfirmationMaterial")

  @@unique([id, classroom_id])
  @@index([classroom_id, unit_id, topic_id])
  @@index([deleted_at, deletion_lease_until])
  @@map("materials")
}

model MaterialRevision {
  previous_id String @id @db.Uuid
  current_id String @unique @db.Uuid
  classroom_id String @db.Uuid
  classroom_revision BigInt
  command_hash String @db.Char(64)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  previous Material @relation("MaterialRevisionPrevious", fields:[previous_id,classroom_id], references:[id,classroom_id], onDelete:Restrict, onUpdate:NoAction, map:"material_revision_previous")
  current Material @relation("MaterialRevisionCurrent", fields:[current_id,classroom_id], references:[id,classroom_id], onDelete:Restrict, onUpdate:NoAction, map:"material_revision_current")
  @@map("material_revisions")
}

model FileObject {
  curriculum_extractions ClassroomCurriculumExtraction[]
  id                    String                    @id @default(uuid()) @db.Uuid
  created_at            DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  classroom_id          String?                   @db.Uuid
  classroom_draft_id    String?                   @db.Uuid
  uploaded_by_id        String                    @db.Uuid
  storage_key           String                    @unique
  original_name         String
  extension             String
  detected_mime_type    String?
  size_bytes            BigInt
  validation_status     ValidationStatus          @default(PENDING)
  scan_status           ScanStatus                @default(PENDING)
  validated_at          DateTime?                 @db.Timestamptz(6)
  scanned_at            DateTime?                 @db.Timestamptz(6)
  rejection_code        String?
  blob_deleted_at       DateTime?                 @db.Timestamptz(6)
  uploaded_by           User                      @relation("FileObject_uploaded_by_id", fields: [uploaded_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  classroom             Classroom?                @relation("FileObject_classroom", fields: [classroom_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  plan_versions         StudyPlanVersion[]        @relation("Plan_file")
  materials             Material[]                @relation("Material_file")
  classroom_draft       ClassroomDraft?           @relation("File_draft", fields: [classroom_draft_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  uploads               Upload[]                  @relation("Upload_file")
  custody               FileCustody?
  activity_instructions ActivityInstructionFile[] @relation("Instruction_file")
  attempt_attachments   AttemptAttachment[]       @relation("Attachment_file")
  foxy_publication FoxyPublication?

  @@unique([id, classroom_id])
  @@index([classroom_id])
  @@index([classroom_draft_id])
  @@index([scan_status, created_at])
  @@map("files")
}

model Upload {
  id                      String       @id @default(uuid()) @db.Uuid
  created_at              DateTime     @default(now()) @db.Timestamptz(6)
  updated_at              DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  file_id                 String       @unique @db.Uuid
  status                  UploadStatus @default(STARTED)
  reserved_bytes          BigInt
  last_activity_at        DateTime     @default(now()) @db.Timestamptz(6)
  completed_at            DateTime?    @db.Timestamptz(6)
  reservation_released_at DateTime?    @db.Timestamptz(6)
  file                    FileObject   @relation("Upload_file", fields: [file_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, last_activity_at])
  @@map("uploads")
}

// P4 proof/lease metadata. Account/session models are unchanged.
model FileCustody {
  file_id          String    @id @db.Uuid
  purpose          String
  target_id        String?   @db.Uuid
  phase            String    @default("reserved")
  digest           String?
  validated_digest String?
  scanned_digest   String?
  operation_id     String?   @db.Uuid
  lease_until      DateTime? @db.Timestamptz(6)
  file             FileObject @relation(fields: [file_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([phase, lease_until])
  @@map("file_custodies")
}

model Activity {
  grading_ai_jobs GradingAiJob[]
  ai_grading_rubric String @default("")
  evaluation_rubric Json @default("[]")
  objective String?
  teacher_comment String?
  generated_by ActivityAiGeneration[] @relation("ActivityGeneration_applied")
  id                     String                    @id @default(uuid()) @db.Uuid
  created_at             DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  classroom_id           String                    @db.Uuid
  unit_id                String?                   @db.Uuid
  topic_id               String?                   @db.Uuid
  type                   ActivityType
  title                  String?
  instructions_text      String?
  attachments_required   Boolean                   @default(false)
  status                 ActivityStatus            @default(DRAFT)
  published_at           DateTime?                 @db.Timestamptz(6)
  deadline_at            DateTime?                 @db.Timestamptz(6)
  allow_late_submissions Boolean                   @default(false)
  first_started_at       DateTime?                 @db.Timestamptz(6)
  classroom              Classroom                 @relation("Activity_classroom", fields: [classroom_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  unit                   Unit?                     @relation("Activity_unit", fields: [unit_id, classroom_id], references: [id, classroom_id], onDelete: Restrict, onUpdate: NoAction)
  topic                  Topic?                    @relation("Activity_topic", fields: [topic_id, unit_id, classroom_id], references: [id, unit_id, classroom_id], onDelete: Restrict, onUpdate: NoAction)
  instruction_files      ActivityInstructionFile[] @relation("Instruction_activity")
  topic_links            ActivityTopic[]           @relation("ActivityTopic_activity")
  material_links         ActivityMaterial[]        @relation("Link_activity")
  questions              Question[]                @relation("Question_activity")
  student_activities     StudentActivity[]         @relation("StudentActivity_activity")
  attempt_attachments    AttemptAttachment[]       @relation("Attachment_activity")
  notifications          Notification[]            @relation("Notification_activity")

  @@unique([id, classroom_id])
  @@index([classroom_id, status, published_at])
  @@index([unit_id, topic_id])
  @@unique([id, unit_id, classroom_id])
  @@map("activities")
}

model ActivityInstructionFile {
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  activity_id  String     @db.Uuid
  classroom_id String     @db.Uuid
  file_id      String     @db.Uuid
  activity     Activity   @relation("Instruction_activity", fields: [activity_id, classroom_id], references: [id, classroom_id], onDelete: Restrict, onUpdate: NoAction)
